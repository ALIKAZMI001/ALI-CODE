{
  "name": "ali-code",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ali Code — a Claude Code-style coding agent for your terminal",
  "bin": {
    "ali": "./dist/index.js",
    "ali-code": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "link": "npm run build && npm link",
    "test": "npm run build && node --test \"tests/*.test.mjs\"",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "openai": "^7.47.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
