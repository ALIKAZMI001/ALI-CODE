# Which provider to use first: openrouter | groq | openai
ALI_PROVIDER=openrouter

# Model for the primary provider. Free tier: use a ":free" model.
# Paid: anthropic/claude-sonnet-4.5, google/gemini-2.5-pro, openai/gpt-5 ...
ALI_MODEL=cohere/north-mini-code:free

# Providers to fall back to when every key on the primary is spent.
# Comma separated. Leave empty to use any other provider that has keys.
ALI_FALLBACK_PROVIDERS=groq
# Model used on the fallback provider (optional).
# ALI_FALLBACK_MODEL=openai/gpt-oss-120b

# --- OpenRouter: comma-separated list, used round-robin ---
OPENROUTER_API_KEYS=key1,key2

# --- Groq ---
GROQ_API_KEYS=key1,key2,key3,key4

# --- Any OpenAI-compatible endpoint ---
# OPENAI_API_KEYS=
# ALI_BASE_URL=https://api.openai.com/v1

# default | accept-edits | plan | yolo
ALI_PERMISSION_MODE=default

# ALI_MAX_TOKENS=8192
# ALI_CONTEXT_TOKENS=128000
# ALI_MAX_ITERATIONS=40

# The old MINI_* names still work, so existing .env files keep working.
